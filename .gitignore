# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# redirect output from backgrounded dev/prod servers
scripts/server.log
scripts/server.err

# typescript
*.tsbuildinfo
next-env.d.ts

# supplied source material
# image/ holds the originals the brief was delivered with — 14 files, 17 MB,
# including a 6.5 MB source video. The processed, serving copies live in
# public/assets/ and ARE tracked; scripts/build-image-ladder.mjs and
# scripts/build-video.mjs derive them from these files. Nothing in the build
# reads image/, so tracking it would only bloat the repository.
/image/

# superpowers session/plan workspace
/.superpowers/
# Smoke test artifacts
scripts/smoke-*
scripts/screenshots/smoke-report.txt
scripts/screenshots/reference/server.log
