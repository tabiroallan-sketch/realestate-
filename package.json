{
  "name": "verde-residences",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify": "npm run verify:content && npm run verify:anchors && npm run verify:planes && npm run typecheck && npm run lint && npm run build",
    "verify:content": "node scripts/verify-content.mjs",
    "verify:anchors": "node scripts/verify-anchors.mjs",
    "verify:planes": "node scripts/verify-plane-math.mjs",
    "verify:smoke": "node scripts/smoke.mjs",
    "verify:journey": "node scripts/journey.mjs",
    "verify:layout": "node scripts/audit-layout.mjs",
    "verify:resilience": "node scripts/verify-plane-resilience.mjs",
    "verify:full": "npm run verify:anchors && npm run verify && node scripts/smoke.mjs && node scripts/journey.mjs && node scripts/audit-layout.mjs && npm run verify:resilience",
    "assets:images": "node scripts/build-image-ladder.mjs",
    "assets:video": "node scripts/build-video.mjs",
    "assets": "npm run assets:images && npm run assets:video"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "playwright": "^1.63.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "fast-glob": "^3.3.3"
  }
}
